<div class="podcast-episode">
    <div class="podcast-episode__embed">
        <iframe
            width="100%"
            height="152"
            frameborder="0"
            allowtransparency="true"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            src="$EmbedURL.ATT"
            title="$Title.ATT"
        ></iframe>
    </div>
</div>
