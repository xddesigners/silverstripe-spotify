{
    "name": "xddesigners/silverstripe-spotify",
    "description": "Spotify podcast integration for SilverStripe: syncs shows and episodes from the Spotify API and renders embeddable players.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "spotify", "podcast", "embed", "audio"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "lekoala/silverstripe-cms-actions": "*",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "XD\\Spotify\\": "src/"
        }
    }
}
